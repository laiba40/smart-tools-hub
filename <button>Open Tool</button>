<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>Smart Tools Hub</title>

<link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;600;700&display=swap" rel="stylesheet">

<style>

*{
margin:0;
padding:0;
box-sizing:border-box;
font-family:Poppins,sans-serif;
}

body{
background:#f4f7fb;
color:#222;
}

header{
background:#2563eb;
color:white;
padding:18px 8%;
display:flex;
justify-content:space-between;
align-items:center;
position:sticky;
top:0;
z-index:1000;
}

header h2{
font-size:28px;
}

nav a{
color:white;
text-decoration:none;
margin-left:25px;
font-weight:500;
}

.hero{

background:linear-gradient(135deg,#2563eb,#4f46e5);

padding:80px 20px;

text-align:center;

color:white;

}

.hero h1{

font-size:50px;

margin-bottom:15px;

}

.hero p{

font-size:20px;

margin-bottom:30px;

}

.hero button{

background:white;

color:#2563eb;

border:none;

padding:15px 35px;

font-size:17px;

border-radius:40px;

cursor:pointer;

font-weight:bold;

transition:.3s;

}

.hero button:hover{

transform:scale(1.05);

}

.search{

width:90%;

max-width:650px;

margin:40px auto;

}

.search input{

width:100%;

padding:16px;

border:none;

border-radius:40px;

box-shadow:0 5px 20px rgba(0,0,0,.12);

font-size:16px;

}

.section-title{

text-align:center;

font-size:34px;

margin:30px 0;

}

.grid{

display:grid;

grid-template-columns:repeat(auto-fit,minmax(250px,1fr));

gap:25px;

padding:0 8% 60px;

}

.card{

background:white;

border-radius:18px;

padding:30px;

box-shadow:0 10px 25px rgba(0,0,0,.08);

transition:.3s;

}

.card:hover{

transform:translateY(-8px);

}

.card h3{

margin:15px 0;

}

.card p{

color:#666;

margin-bottom:20px;

}

.card button{

background:#2563eb;

color:white;

border:none;

padding:12px 25px;

border-radius:30px;

cursor:pointer;

}

.features{

background:white;

padding:70px 8%;

display:grid;

grid-template-columns:repeat(auto-fit,minmax(220px,1fr));

gap:25px;

text-align:center;

}

.feature{

padding:30px;

}

.feature h2{

font-size:45px;

}

footer{

background:#111827;

color:white;

text-align:center;

padding:35px;

margin-top:40px;

}

@media(max-width:700px){

.hero h1{

font-size:34px;

}

header{

flex-direction:column;

}

nav{

margin-top:10px;

}

}

</style>

</head>

